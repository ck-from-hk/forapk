<?xml version='1.0' encoding='utf-8'?>
<widget id="com.ckfromhk.cangjie" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    
    <!-- App 顯示名稱（安裝到手機後的桌面名稱） -->
    <name>快快快樂學倉jie</name>
    
    <!-- App 簡介 -->
    <description>
        九十年代 DOS 打字教學程式致敬之作，單一 HTML 檔、離線可玩。
    </description>
    
    <!-- 作者與聯絡資訊 -->
    <author email="support@example.com" href="https://github.com/ck-from-hk/-">
        CK from HK
    </author>

    <!-- 專案進入點與網址白名白 (Whitelisting) -->
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geoloc:*" />

    <!-- Android 平台專屬設定 -->
    <platform name="android">
        <allow-intent href="market:*" />
        
        <!-- 鎖定橫向畫面（符合 DOS 960x540 遊戲比例） -->
        <preference name="Orientation" value="landscape" />
        
        <!-- 全螢幕與沈浸式模式設定 -->
        <preference name="Fullscreen" value="true" />
        <preference name="HideSplashScreenSpinner" value="true" />
    </platform>

    <!-- iOS 平台專屬設定（若未來擴充支援） -->
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
        <preference name="Orientation" value="landscape" />
    </platform>

    <!-- App Icon 設定（由 GitHub Actions 自動寫入） -->
    <!-- <icon src="icon.png" /> -->

</widget>
